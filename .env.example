# =============================================================================
# KISAN COMPASS — Environment Variables Template
# Copy this file to .env and configure your production credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# Application Mode ('production' or 'demo')
# In 'production', real Supabase Auth & PostgreSQL DB are enforced.
# -----------------------------------------------------------------------------
VITE_APP_MODE=production

# -----------------------------------------------------------------------------
# Supabase PostgreSQL & Authentication (Multi-Tenant Storage & RLS)
# Replace with your project URL and public anon key from Supabase Dashboard
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# -----------------------------------------------------------------------------
# Production API Configuration (Optional External Keys)
# Open-Meteo Weather API is public and free without an API key.
# AGMARKNET and routing keys can be supplied for expanded live query limits.
# -----------------------------------------------------------------------------
VITE_WEATHER_API_KEY=
VITE_MARKET_API_KEY=
VITE_ROUTING_API_KEY=
